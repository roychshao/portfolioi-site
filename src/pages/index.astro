---
// Home page — full block order per plan §頁面結構: Nav, Hero, Work,
// Honors & Writing, About, Contact + Footer (Tasks 4-6).
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import CaseList from '../components/CaseList.astro';
import HonorsWriting from '../components/HonorsWriting.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/site';
---
<BaseLayout title={`${profile.name} — ${profile.role}`}>
  <Nav />
  <main id="main">
    <Hero />
    <CaseList />
    <HonorsWriting />
    <About />
  </main>
  <Footer />
</BaseLayout>
