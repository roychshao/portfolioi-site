---
// BaseLayout — the single document shell: SEO/OG head, self-hosted fonts, global.css.
// All copy comes from src/data/site.ts (single source of truth).
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import { profile, hero } from '../data/site';

interface Props {
  title?: string;
  desc?: string;
}

const {
  title = `${profile.name} · ${profile.role}`,
  desc = hero.sub,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// `>_` favicon as inline SVG data-URI (mono brand mark, primary-blue tile).
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E" +
  "%3Crect width='32' height='32' rx='7' fill='%232563eb'/%3E" +
  "%3Ctext x='16' y='23' font-family='monospace' font-size='17' font-weight='700' " +
  "fill='white' text-anchor='middle'%3E%3E_%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- No-flash js flag (Task 5 owns html.js): set before first paint so the
         .js-gated hidden states apply atomically; content stays fail-open if JS
         never runs. main.ts re-adds the class as a belt-and-braces fallback. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="theme-color" content="#f8fafc" />
  </head>
  <body>
    <slot />
  </body>
</html>
