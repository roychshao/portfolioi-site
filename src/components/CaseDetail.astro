---
// CaseDetail — the accordion panel body: challenge → approach steps → results,
// then the case's figures, then its links. Content renders only from site.ts;
// "Challenge"/"Approach"/"Results" are structural labels (like Nav's sr-only
// "Menu"), not page copy. dcim passes figures = [] → zero <img> in the panel.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Case } from '../data/site';

export interface Figure {
  src: ImageMetadata;
  alt: string;
  width: number;
}

interface Props {
  caseItem: Case;
  figures: Figure[];
}

const { caseItem, figures } = Astro.props;
---
<div class="case-body">
  <p class="case-label">Challenge</p>
  <p class="case-challenge">{caseItem.body.challenge}</p>

  <p class="case-label">Approach</p>
  <ol class="case-approach">
    {caseItem.body.approach.map((s) => <li><span class="step-title">{s.title}</span><p>{s.text}</p></li>)}
  </ol>

  <p class="case-label">Results</p>
  <ul class="case-results">
    {caseItem.body.results.map((r) => (
      <li class="result"><span class="result-metric">{r.metric}</span><span class="result-label">{r.label}</span></li>
    ))}
  </ul>

  {figures.length > 0 && (
    <div class="case-figures">
      {figures.map((f) => <figure class={f.width >= 960 ? 'fig fig-wide' : 'fig'}><Image src={f.src} width={f.width} widths={[Math.round(f.width / 2), f.width]} alt={f.alt} loading="lazy" /></figure>)}
    </div>
  )}

  <div class="case-links">
    {caseItem.links.map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}<span aria-hidden="true"> ↗</span></a>)}
  </div>
</div>
<style>
  .case-body > * + * { margin-top: 1.1rem; }

  .case-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 0;
  }

  .case-challenge {
    max-width: 58ch;
    color: var(--c-ink);
    margin: 0;
  }

  .case-approach {
    margin: 0;
    padding: 0 0 0 1.35rem;
    display: grid;
    gap: 0.85rem;
    counter-reset: step;
    list-style: none;
  }
  .case-approach li { position: relative; }
  .case-approach li::before {
    counter-increment: step;
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: -1.35rem;
    top: 0.05em;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--c-primary);
  }
  .step-title { font-weight: 700; }
  .case-approach p { margin: 0.15rem 0 0; color: var(--c-muted); max-width: 58ch; }

  .case-results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11.5rem, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .result {
    padding: 0.7rem 0.85rem;
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .result-metric {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1.05rem, 2.5vw, 1.35rem);
    color: var(--c-primary);
    line-height: 1.25;
  }
  .result-label { font-size: 0.8rem; color: var(--c-muted); line-height: 1.5; }

  .case-figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 0.85rem;
    align-items: start;
  }
  .fig { margin: 0; }
  .fig-wide { grid-column: 1 / -1; }
  .fig img {
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-card);
  }

  .case-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .case-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.45rem 1rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-pill);
    font-size: 0.9rem;
    font-weight: 600;
    background: var(--c-card);
  }
  .case-links a:hover { border-color: var(--c-primary); text-decoration: none; }
</style>
