---
// Honors & Writing: TANET Best Paper as a wide banner card (pinned repo link,
// derived from the honor URL so no second copy of it exists) + exactly the two
// Medium articles from `writing` as horizontal link cards. All copy from site.ts.
import { honors, honorsWriting, writing } from '../data/site';
import Icon from './Icons.astro';

// Repo display name is URL-derived — the canonical link stays the single source.
const repoName = (url: string) => new URL(url).pathname.replace(/^\/roychshao\//, '');
const hostLabel = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---
<section id="honors-writing" class="honors-writing reveal">
  <h2 class="section-title">{honorsWriting.title}</h2>

  <div class="honor-stack">
    {honors.map((h) => (
      <article class="honor card reveal">
        <span class="honor-medal" aria-hidden="true"><Icon name="github" size={22} /></span>
        <div class="honor-body">
          <h3 class="honor-title">{h.title}</h3>
          <p class="honor-detail">{h.detail}</p>
        </div>
        <div class="honor-side">
          <span class="pill honor-year">{h.year}</span>
          <a class="honor-repo" href={h.url} target="_blank" rel="noopener noreferrer">{repoName(h.url)}</a>
        </div>
      </article>
    ))}
  </div>

  <div class="writing-grid">
    {writing.map((w) => (
      <a class="writing-card card reveal" href={w.url} target="_blank" rel="noopener noreferrer">
        <span class="writing-meta">{hostLabel(w.url)} · <time datetime={w.date}>{w.date}</time></span>
        <span class="writing-title">{w.title}</span>
        <span class="writing-go" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>
<style>
  .honors-writing {
    max-width: 62rem;
    margin: 0 auto;
    padding: var(--space-section) clamp(1rem, 4vw, 2rem);
  }

  .honor-stack { display: grid; gap: 1rem; margin-top: 1.5rem; }

  .honor {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.1rem;
    padding: 1.15rem clamp(1rem, 3vw, 1.4rem);
  }

  .honor-medal {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    color: var(--c-primary);
  }

  .honor-body { min-width: 0; }
  .honor-title { font-size: 1.05rem; margin: 0 0 0.2rem; }
  .honor-detail { margin: 0; color: var(--c-muted); font-size: 0.9rem; line-height: 1.55; }

  .honor-side { display: grid; gap: 0.45rem; justify-items: end; }
  .honor-year { font-family: var(--font-mono); border-color: var(--c-primary); color: var(--c-primary); }
  .honor-repo {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--c-muted);
    overflow-wrap: anywhere;
    text-align: right;
  }
  .honor-repo:hover { color: var(--c-primary); }

  .writing-grid { display: grid; gap: 1rem; margin-top: 1rem; }
  @media (min-width: 768px) {
    .writing-grid { grid-template-columns: 1fr 1fr; }
  }

  .writing-card {
    position: relative;
    display: grid;
    gap: 0.4rem;
    padding: 1.1rem 2.6rem 1.1rem 1.25rem;
    color: var(--c-ink);
    min-width: 0;
  }
  .writing-card:hover {
    text-decoration: none;
    border-color: var(--c-primary);
  }

  .writing-meta { font-family: var(--font-mono); font-size: 0.72rem; color: var(--c-muted); }
  .writing-title { font-size: 0.95rem; font-weight: 700; line-height: 1.45; letter-spacing: -0.01em; }
  .writing-go {
    position: absolute;
    right: 1.1rem;
    bottom: 0.95rem;
    color: var(--c-primary);
    font-weight: 700;
  }

  @media (max-width: 639px) {
    .honor { grid-template-columns: minmax(0, 1fr); }
    .honor-medal { display: none; }
    .honor-side { justify-items: start; }
    .honor-repo { text-align: left; }
  }
</style>
