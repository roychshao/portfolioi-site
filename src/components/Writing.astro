---
// Writing section — exactly the two Medium articles from `writing` as
// horizontal link cards. All copy from site.ts. (Honors moved out: the TANET
// award now lives as a badge on its Research item + the About timeline.)
import { writing, writingSection } from '../data/site';

const hostLabel = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---
<section id="writing" class="writing reveal">
  <h2 class="section-title">{writingSection.title}</h2>

  <div class="writing-grid">
    {writing.map((w) => (
      <a class="writing-card card reveal" href={w.url} target="_blank" rel="noopener noreferrer">
        <span class="writing-meta">{hostLabel(w.url)} · <time datetime={w.date}>{w.date}</time></span>
        <span class="writing-title">{w.title}</span>
        <span class="writing-go" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>
<style>
  .writing {
    max-width: 62rem;
    margin: 0 auto;
    padding: var(--space-section) clamp(1rem, 4vw, 2rem);
  }

  .writing-grid { display: grid; gap: 1rem; margin-top: 1.5rem; }
  @media (min-width: 768px) {
    .writing-grid { grid-template-columns: 1fr 1fr; }
  }

  .writing-card {
    position: relative;
    display: grid;
    gap: 0.4rem;
    padding: 1.1rem 2.6rem 1.1rem 1.25rem;
    color: var(--c-ink);
    min-width: 0;
  }
  .writing-card:hover {
    text-decoration: none;
    border-color: var(--c-primary);
  }

  .writing-meta { font-family: var(--font-mono); font-size: 0.72rem; color: var(--c-muted); }
  .writing-title { font-size: 0.95rem; font-weight: 700; line-height: 1.45; letter-spacing: -0.01em; }
  .writing-go {
    position: absolute;
    right: 1.1rem;
    bottom: 0.95rem;
    color: var(--c-primary);
    font-weight: 700;
  }
</style>
